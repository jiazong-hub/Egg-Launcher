<Window x:Class="Launcher.App.LocalServiceCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 ChatGPT Local Launcher"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                   Text="Local 后台服务仍在运行" />
        <TextBlock Grid.Row="1" Margin="0,12,0,24" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryBrush}"
                   Text="仅关闭窗口会保留 Agent、回环代理和 llama.cpp Router，ChatGPT Local 可继续使用。停止服务会释放程序目录，但当前 Local 客户端将无法继续请求；已保存的 Local 模式和模型配置不会被切回或删除。" />

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Padding="16,9" Content="取消" IsCancel="True" Click="CancelButton_Click" />
            <Button Padding="16,9" Content="仅关闭窗口" IsDefault="True" Click="KeepServiceButton_Click" />
            <Button Margin="0" Padding="16,9" Content="停止服务并退出" Click="StopServiceButton_Click" />
        </StackPanel>
    </Grid>
</Window>
