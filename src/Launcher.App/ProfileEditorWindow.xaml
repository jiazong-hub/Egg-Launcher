<Window x:Class="Launcher.App.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launcher.App"
        Title="{DynamicResource ProfileEditorTitle}"
        Icon="Assets/egg-mark.png"
        Height="720"
        Width="820"
        MinHeight="480"
        MinWidth="640"
        FontSize="12"
        FontWeight="Normal"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Local to the profile editor: identical input geometry across all tabs. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrightBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="TextWrapping" Value="Wrap">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Trigger>
                <Trigger Property="AcceptsReturn" Value="True">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The editable combo's text area has no frame and never inherits outer input geometry. -->
        <Style x:Key="ProfileComboEditorStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrightBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="ArrowSurface" Width="24" Height="22" Margin="3" VerticalAlignment="Center" CornerRadius="4"
                                    HorizontalAlignment="Right" Background="{DynamicResource ComboArrowSurfaceBrush}">
                                <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="{DynamicResource SecondaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboChrome" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2"
                                                  Style="{StaticResource ProfileComboToggleStyle}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter x:Name="SelectionPresenter" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ProfileComboEditorStyle}" Grid.Column="0" Visibility="Collapsed"
                                             MinHeight="0" BorderThickness="0"
                                             Background="Transparent" FocusVisualStyle="{x:Null}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,4,0,0" Padding="3" CornerRadius="5"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1" />
                                <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileEditorTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True"
                              KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1" />
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="HeaderChrome"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border x:Name="SelectionIndicator"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentBrush}"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="HeaderChrome" Property="Background" Value="Transparent" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="{local:MotionDuration Milliseconds=160}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="{local:MotionDuration Milliseconds=100}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                       Text="{DynamicResource ModelParameters}" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"
                       Text="{DynamicResource ModelParametersHint}" />
        </StackPanel>

        <TabControl x:Name="ProfileEditorTabs" Grid.Row="1" Margin="0,20,0,18"
                    Style="{StaticResource ProfileEditorTabControlStyle}"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    SelectionChanged="ProfileEditorTabs_SelectionChanged">
            <TabItem Header="{DynamicResource BasicParameters}">
                <ScrollViewer FontSize="12" FontWeight="Normal" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                              Margin="0,16,0,0" Padding="0,0,12,0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <Border Padding="18" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}"
                            HorizontalAlignment="Stretch"
                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                            MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
                        <StackPanel>

                    <Border Margin="0,0,0,18" Padding="14" CornerRadius="8"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource LongConversationSettings}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Context" />
                                    <ComboBox x:Name="ContextSizeComboBox" Margin="0,5,0,12"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectionChanged="ContextSizeComboBox_SelectionChanged"
                                              ToolTip="{DynamicResource ContextSelectionTip}" />
                                    <TextBox x:Name="CustomContextSizeTextBox" Margin="0,-6,0,10"
                                             Visibility="Collapsed" TextChanged="CustomContextSizeTextBox_TextChanged"
                                             ToolTip="{DynamicResource CustomContextTip}" />
                                    <TextBlock x:Name="ContextLimitTextBlock" Margin="0,-4,0,12"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ContextRiskTextBlock" Margin="0,-4,0,12"
                                               Foreground="{DynamicResource ProfileWarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Visibility="Collapsed" Text="{DynamicResource LowContextWarning}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource CompactionReserve}" />
                                    <ComboBox x:Name="CompactionSafetyReserveComboBox" IsEditable="True" IsTextSearchEnabled="False" Margin="0,5,0,12"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectionChanged="CompactionSafetyReserveComboBox_SelectionChanged"
                                              ToolTip="{DynamicResource CompactionReserveTip}" />
                                    <TextBlock x:Name="ReserveRangeTextBlock" Margin="0,-6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource ToolOutputHistoryLimit}" />
                                    <ComboBox x:Name="ToolOutputTokenLimitComboBox" IsEditable="True" IsTextSearchEnabled="False" Margin="0,5,0,12"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              ToolTip="{DynamicResource ToolOutputHistoryLimitTip}" />
                                    <TextBlock x:Name="ToolRangeTextBlock" Margin="0,-6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="AutoCompactThresholdTextBlock" Grid.Row="1" Grid.Column="2"
                                           Margin="0,0,0,14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock x:Name="ConversationValidationTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource ProfileWarningBrush}" Visibility="Collapsed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Margin" Value="0,0,0,12" />
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Height" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource SecondaryBrush}"
                                       TextWrapping="Wrap" Text="{DynamicResource CompactionExplanation}" />
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource CodexStreamIdleTimeout}" />
                            <ComboBox x:Name="CodexStreamIdleTimeoutComboBox" IsEditable="True" IsTextSearchEnabled="False"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,5,0,8"
                                      ToolTip="{DynamicResource CodexStreamIdleTimeoutTip}" />
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                       Text="{DynamicResource CodexStreamIdleTimeoutTip}" />
                            <CheckBox FontSize="12" x:Name="ContextShiftCheckBox"
                                      Style="{StaticResource StartupToggleStyle}"
                                      FontWeight="SemiBold"
                                      Content="{DynamicResource ContextShiftEnabled}"
                                      ToolTip="{DynamicResource ContextShiftTip}"
                                      Checked="ContextShiftCheckBox_Changed"
                                      Unchecked="ContextShiftCheckBox_Changed" />
                            <TextBlock Margin="0,7,64,0" Foreground="{DynamicResource SecondaryBrush}"
                                       TextWrapping="Wrap" Text="{DynamicResource ContextShiftTip}" />
                            <Button x:Name="ContextShiftDetectButton" Content="{DynamicResource ContextShiftRedetect}" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ContextShiftDetectButton_Click" />
                            <TextBlock x:Name="ContextShiftStatusTextBlock" Margin="0,7,0,0"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="GPU Offload" />
                            <ComboBox x:Name="GpuLayersComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="GpuLayersComboBox_SelectionChanged"
                                      ToolTip="{DynamicResource GpuLayersTip}" />
                            <TextBox x:Name="CustomGpuLayersTextBox" Margin="0,-6,0,10" Visibility="Collapsed"
                                     ToolTip="{DynamicResource GpuLayersCustomTip}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="Flash Attention" />
                            <ComboBox x:Name="FlashAttentionComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource FlashAttentionTip}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock FontWeight="SemiBold" Text="K Cache" />
                            <ComboBox x:Name="CacheTypeKComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource KvCacheTip}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="V Cache" />
                            <ComboBox x:Name="CacheTypeVComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource VCacheTip}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock FontWeight="SemiBold" Text="Batch Size" />
                            <ComboBox x:Name="BatchSizeComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource BatchSizeTip}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="Micro Batch" />
                            <ComboBox x:Name="MicroBatchSizeComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource MicroBatchTip}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource ParallelSlots}" />
                            <ComboBox x:Name="ParallelComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource ParallelSlotsTip}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource IdleReleaseVram}" />
                            <ComboBox x:Name="IdleSleepSecondsComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource IdleReleaseVramTip}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox FontSize="12" x:Name="JinjaCheckBox" Margin="0,2,0,0" FontWeight="SemiBold"
                              Checked="TemplatePath_Changed" Unchecked="TemplatePath_Changed"
                              Content="{DynamicResource EnableJinja}"
                              ToolTip="{DynamicResource EnableJinjaTip}" />

                    <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="{DynamicResource ChatTemplateFile}" />
                    <TextBox x:Name="ChatTemplatePathTextBox" Margin="0,5,0,0"
                             TextChanged="TemplatePath_Changed"
                             ToolTip="{DynamicResource ChatTemplateFileTip}" />
                    <TextBlock x:Name="TemplateStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="{DynamicResource CheckChatTemplate}" Click="CheckTemplateButton_Click" />
                        <Button Content="{DynamicResource OpenTemplateFolder}" Click="OpenTemplateFolder_Click" />
                        <Button Content="{DynamicResource RestoreEmbeddedTemplate}" Click="RestoreEmbeddedTemplate_Click" />
                    </WrapPanel>
                    <Grid x:Name="MoeBasicPanel" Margin="0,18,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource ExpertPlacement}" />
                            <ComboBox x:Name="MoePlacementComboBox" Margin="0,5,0,12"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="MoePlacementComboBox_SelectionChanged"
                                      ToolTip="{DynamicResource ExpertPlacementTip}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource CpuExpertLayers}" />
                            <TextBox x:Name="CpuMoeLayersTextBox" Margin="0,5,0,12"
                                     ToolTip="{DynamicResource CpuExpertLayersTip}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource LoadMode}" />
                            <ComboBox x:Name="MoeLoadModeComboBox" Margin="0,5,0,0"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource LoadModeTip}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource AutoMemoryFit}" />
                            <ComboBox x:Name="MoeFitComboBox" Margin="0,5,0,0"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource AutoMemoryFitTip}" />
                        </StackPanel>
                    </Grid>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource ThinkingSettings}">
                <ScrollViewer FontSize="12" FontWeight="Normal" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                              Margin="0,16,0,0" Padding="0,0,12,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
