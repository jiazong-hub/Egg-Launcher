                            </local:ProfileParameterPanel>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource YarnParameters}"/>
                            <TextBox x:Name="YarnArgumentsTextBox" Margin="0,5,0,12"
                                     ToolTip="{DynamicResource YarnParametersTip}"/>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource TensorPlacement}"/>
                            <TextBox x:Name="OverrideTensorTextBox" Margin="0,5,0,0" TextWrapping="Wrap"
                                     ToolTip="{DynamicResource TensorPlacementTip}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SandboxSettingsTab" Header="{DynamicResource SandboxSettings}">
                <ScrollViewer FontSize="12" FontWeight="Normal" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                              Margin="0,16,0,0" Padding="0,0,12,0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <Border Padding="18" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}"
                            HorizontalAlignment="Stretch"
                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                            MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource SecondaryBrush}"
                                       TextWrapping="Wrap" Text="{DynamicResource SandboxSettingsHint}" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource SandboxAllowNetwork}" />
                                <CheckBox x:Name="SandboxNetworkCheckBox" IsThreeState="True" HorizontalAlignment="Right"
                                          Style="{StaticResource StartupToggleStyle}"
                                          Checked="SandboxNetworkToggle_Changed" Unchecked="SandboxNetworkToggle_Changed"
                                          Indeterminate="SandboxNetworkToggle_Changed" />
                            </Grid>
                            <TextBlock x:Name="SandboxNetworkStateTextBlock" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryBrush}" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource SandboxNetworkCompatibility}" />
                                <CheckBox x:Name="SandboxCompatibilityCheckBox" HorizontalAlignment="Right"
                                          Style="{StaticResource StartupToggleStyle}"
                                          Checked="SandboxCompatibility_Changed" Unchecked="SandboxCompatibility_Changed" />
                            </Grid>
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"
                                       Text="{DynamicResource SandboxCompatibilityHint}" />
                            <Button x:Name="SandboxCheckNetworkButton" HorizontalAlignment="Left" Padding="12,7"
                                    Content="{DynamicResource SandboxCheckNetwork}" Click="SandboxCheckNetwork_Click" />
                            <TextBlock x:Name="SandboxNetworkResultTextBlock" Margin="0,8,0,8" TextWrapping="Wrap" />
                            <Expander Header="{DynamicResource SandboxNetworkDetails}" Margin="0,0,0,14">
                                <TextBox x:Name="SandboxNetworkDetailsTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                         MaxHeight="200" VerticalScrollBarVisibility="Auto" />
                            </Expander>
                            <Border Margin="0,0,0,14" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,1,0,0" />
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource SandboxAdditionalPaths}" />
                            <TextBlock Margin="0,5,0,10" Foreground="{DynamicResource SecondaryBrush}"
                                       TextWrapping="Wrap" Text="{DynamicResource SandboxAdditionalPathsTip}" />
                            <StackPanel x:Name="SandboxPathsPanel" />
                            <StackPanel Orientation="Horizontal">
                            <Button HorizontalAlignment="Left" Padding="12,7"
                                    Content="{DynamicResource SandboxAddPath}"
                                    Click="AddSandboxPathButton_Click" />
                            <Button x:Name="CommonSandboxPathsButton" Margin="8,0,0,0" Padding="12,7"
                                    Click="CommonSandboxPaths_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource ModelInformation}">
                <ScrollViewer FontSize="12" FontWeight="Normal" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                              Margin="0,16,0,0" Padding="0,0,12,0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <Border Padding="18" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}"
                            HorizontalAlignment="Stretch"
                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                            MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource DisplayName}" />
                            <TextBox x:Name="DisplayNameTextBox" Margin="0,5,0,12"
                                     ToolTip="{DynamicResource DisplayNameTip}" />

                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource ModelAlias}" />
                            <TextBox x:Name="AliasTextBox" Margin="0,5,0,12" IsReadOnly="True"
                                     ToolTip="{DynamicResource ModelAliasTip}" />

                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource ModelFile}" />
                            <TextBox x:Name="ModelPathTextBox" Margin="0,6,0,18" IsReadOnly="True"
                                     ToolTip="{DynamicResource ModelFileTip}" />

                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource ModelType}" />
                            <TextBlock x:Name="ModelTypeTextBlock" Margin="0,5,0,0" Padding="9,7"
                                       Background="{DynamicResource CardBackgroundBrush}" TextWrapping="Wrap"
                                       ToolTip="{DynamicResource ModelTypeEditorTip}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" HorizontalAlignment="Stretch">
            <WrapPanel HorizontalAlignment="Left">
                <Button x:Name="TemplateCancelButton" Visibility="Collapsed" Content="{DynamicResource CancelDetection}" Click="CancelTemplateCheck_Click" />
                <Button x:Name="ContextShiftCancelButton" Visibility="Collapsed" Content="{DynamicResource CancelDetection}" Click="ContextShiftCancelButton_Click" Margin="0,0,10,0" />
            <Button x:Name="RestoreModelDefaultsButton" Padding="14,9" Content="{DynamicResource RestoreModelDefaults}"
                        ToolTip="{DynamicResource RestoreModelDefaultsTip}"
                        Click="RestoreModelDefaultsButton_Click" />
                <Button Padding="18,9" Content="{DynamicResource Cancel}" IsCancel="True" />
                <Button Padding="18,9" Content="{DynamicResource Save}" IsDefault="True"
                        x:Name="SaveProfileButton" Click="SaveButton_Click" />
                <Button Margin="0" Padding="16,9" Content="{DynamicResource SaveAsModelDefault}"
                        ToolTip="{DynamicResource SaveAsModelDefaultTip}"
                        x:Name="SaveModelDefaultButton" Click="SaveAsModelDefaultButton_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
