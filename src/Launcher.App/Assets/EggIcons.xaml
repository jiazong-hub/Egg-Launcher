<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="EggIconPathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="EggIconEllipseStyle" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="EggIconRectangleStyle" TargetType="Rectangle">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <DataTemplate x:Key="HomeIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 3,10.5 L 12,3 21,10.5 M 5,9 L 5,21 19,21 19,9 M 9,21 L 9,14 15,14 15,21" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ModeIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 8,6 C 11,6 13,5 16,5 M 18,7 L 18,16 M 16,18 L 9,18 M 7,16 C 7,12 6,10 6,8" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="3.5" Canvas.Top="3.5" Width="5" Height="5" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="15.5" Canvas.Top="2.5" Width="5" Height="5" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="15.5" Canvas.Top="15.5" Width="5" Height="5" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="4.5" Canvas.Top="15.5" Width="5" Height="5" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ModelsIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 12,3 L 21,8 12,13 3,8 Z M 3,8 L 3,16 12,21 21,16 21,8 M 12,13 L 12,21" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="LaunchIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 10,8 L 16,12 10,16 Z" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="HardwareIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource EggIconRectangleStyle}" Canvas.Left="3" Canvas.Top="4" Width="18" Height="13" RadiusX="1.5" RadiusY="1.5" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 12,17 L 12,21 M 8,21 L 16,21" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="StatusIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 2.5,12 L 7,12 9.5,5 14,19 16.5,12 21.5,12" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SettingsIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="5" Canvas.Top="5" Width="14" Height="14" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 12,2 L 12,5 M 12,19 L 12,22 M 2,12 L 5,12 M 19,12 L 22,12 M 4.9,4.9 L 7,7 M 17,17 L 19.1,19.1 M 19.1,4.9 L 17,7 M 7,17 L 4.9,19.1" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="OpenAiIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="3" Canvas.Top="8" Width="18" Height="8" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="3" Canvas.Top="8" Width="18" Height="8" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="60" /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="3" Canvas.Top="8" Width="18" Height="8" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="120" /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="LocalModelIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource EggIconRectangleStyle}" Canvas.Left="2.5" Canvas.Top="3.5" Width="19" Height="14" RadiusX="1.5" RadiusY="1.5" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 12,17.5 L 12,21 M 8,21 L 16,21 M 7.5,9 L 12,6.5 16.5,9 12,11.5 Z M 7.5,9 L 7.5,12.5 12,15 16.5,12.5 16.5,9 M 12,11.5 L 12,15" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="RuntimeIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource EggIconRectangleStyle}" Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" RadiusX="2" RadiusY="2" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 7,8 L 10,11 7,14 M 12.5,15 L 17,15" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ManageModelsIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="2.5" Canvas.Top="3" Width="13" Height="5" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 2.5,5.5 L 2.5,16.5 C 2.5,18 5.5,19.5 9,19.5 M 15.5,5.5 L 15.5,10 M 2.5,11 C 2.5,12.5 5.5,14 9,14 11,14 12.5,13.6 13.5,13" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="13" Canvas.Top="12" Width="8" Height="8" />
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="16" Canvas.Top="15" Width="2" Height="2" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 17,10.5 L 17,12 M 17,20 L 17,21.5 M 11.5,16 L 13,16 M 21,16 L 22.5,16 M 13.1,12.1 L 14.2,13.2 M 19.8,18.8 L 20.9,19.9 M 20.9,12.1 L 19.8,13.2 M 14.2,18.8 L 13.1,19.9" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchModelsIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource EggIconEllipseStyle}" Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" />
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 14.5,14.5 L 21,21" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="DownloadIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" Data="M 12,3 L 12,15 M 7,10 L 12,15 17,10 M 4,18 L 4,21 20,21 20,18" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ExternalLinkIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}"
                  Data="M 13,4 L 20,4 20,11 M 20,4 L 10.5,13.5 M 18,13 L 18,19 C 18,20.1 17.1,21 16,21 L 5,21 C 3.9,21 3,20.1 3,19 L 3,8 C 3,6.9 3.9,6 5,6 L 11,6" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="RefreshIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" StrokeThickness="2"
                  Data="M 19.2,8 A 8,8 0 1 0 20,14 M 19.2,8 L 19.2,3.8 M 19.2,8 L 15,8" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="LightbulbOnIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" StrokeThickness="1.9"
                  Data="M 8.2,14.2 C 6.8,13.1 6,11.3 6,9.5 A 6,6 0 0 1 18,9.5 C 18,11.3 17.2,13.1 15.8,14.2 C 14.9,14.9 14.5,15.8 14.5,17 L 9.5,17 C 9.5,15.8 9.1,14.9 8.2,14.2 M 9.5,20 L 14.5,20 M 10,17 L 14,17 M 12,1 L 12,3 M 4.2,3.8 L 5.7,5.3 M 19.8,3.8 L 18.3,5.3 M 2,10 L 4,10 M 20,10 L 22,10" />
        </Canvas></Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="LightbulbOffIconTemplate">
        <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
            <Path Style="{StaticResource EggIconPathStyle}" StrokeThickness="1.9"
                  Data="M 8.2,14.2 C 6.8,13.1 6,11.3 6,9.5 A 6,6 0 0 1 16.6,5.7 M 17.8,8 C 18.6,10.3 17.8,12.7 15.8,14.2 C 14.9,14.9 14.5,15.8 14.5,17 L 9.5,17 C 9.5,15.8 9.1,14.9 8.2,14.2 M 9.5,20 L 14.5,20 M 10,17 L 14,17 M 3,3 L 21,21" />
        </Canvas></Viewbox>
    </DataTemplate>
</ResourceDictionary>
