<Application x:Class="Launcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Launcher.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Localization/Strings.zh-CN.xaml" />
                <ResourceDictionary Source="Assets/EggIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#06182B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0A2138" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0B233A" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#102E4B" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#F3F8FF" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#A9C4DE" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6F91AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#19B9FF" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#48E5FF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6680" />
        <SolidColorBrush x:Key="LineBrush" Color="#24577B" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#0A2138" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#2A83BC" />
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="#B20B233A" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#287EB7" />
        <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#132E49" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1B4770" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0E75B8" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FFE4E9" />
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#361A29" />
        <SolidColorBrush x:Key="InputSurfaceBrush" Color="#0A1D31" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#316587" />
        <SolidColorBrush x:Key="ListSurfaceBrush" Color="#07192A" />
        <SolidColorBrush x:Key="ComboArrowSurfaceBrush" Color="#133652" />
        <SolidColorBrush x:Key="SelectedItemBrush" Color="#15527C" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#071A2C" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#287EB7" />
        <SolidColorBrush x:Key="ScrollThumbBorderBrush" Color="#3BA7E6" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#1AAEEB" />
        <SolidColorBrush x:Key="ScrollThumbDraggingBrush" Color="#19D4F2" />
        <SolidColorBrush x:Key="ProgressBorderBrush" Color="#285A7C" />
        <SolidColorBrush x:Key="ToggleTrackBrush" Color="#15324C" />
        <SolidColorBrush x:Key="ToggleTrackBorderBrush" Color="#39759E" />
        <SolidColorBrush x:Key="ToggleThumbBrush" Color="#B9C9D8" />
        <SolidColorBrush x:Key="SelectionBoxBorderBrush" Color="#9BB5CB" />
        <SolidColorBrush x:Key="PerformanceRingTrackBrush" Color="#184865" />
        <SolidColorBrush x:Key="PerformanceRingProgressBrush" Color="#18D5F8" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#2786C6" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#B2071A2D" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#00000000" />
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1C557B" />
        <SolidColorBrush x:Key="ModePendingCardBrush" Color="#C7133859" />
        <SolidColorBrush x:Key="NotificationBackgroundBrush" Color="#9A0A243C" />
        <SolidColorBrush x:Key="NotificationBorderBrush" Color="#246C9C" />
        <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#BE124069" />
        <SolidColorBrush x:Key="TitleButtonHoverBrush" Color="#183A59" />
        <SolidColorBrush x:Key="TitleButtonPressedBrush" Color="#24608F" />
        <SolidColorBrush x:Key="TitleCloseHoverBrush" Color="#B9344A" />
        <SolidColorBrush x:Key="TitleClosePressedBrush" Color="#8F2739" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF7E6" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#7A4B00" />
        <SolidColorBrush x:Key="ProfileWarningBrush" Color="#B45309" />
        <Color x:Key="AccentGlowColor">#22D3EE</Color>
        <Thickness x:Key="AdaptiveCardPadding">22</Thickness>

        <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#071B31" Offset="0" />
            <GradientStop Color="#031324" Offset="0.55" />
            <GradientStop Color="#08243D" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#176EFF" Offset="0" />
            <GradientStop Color="#09C9FF" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="{DynamicResource AdaptiveCardPadding}" />
        </Style>

        <Style x:Key="ModeParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
        </Style>

        <Style x:Key="ModeParameterValueStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="MotionRoot" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MotionScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="MotionTranslate" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <Border x:Name="HoverChrome" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource ButtonHoverBrush}"
                                    BorderBrush="{DynamicResource AccentBrightBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <Border x:Name="PressedChrome" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource ButtonPressedBrush}"
                                    BorderBrush="{DynamicResource AccentBrightBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="{local:MotionDuration Milliseconds=140}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="{local:MotionDuration Milliseconds=120}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="{local:MotionDuration Milliseconds=70}" />
                                            <DoubleAnimation Storyboard.TargetName="MotionScale" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="{local:MotionDuration Milliseconds=70}" />
                                            <DoubleAnimation Storyboard.TargetName="MotionScale" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="{local:MotionDuration Milliseconds=70}" />
                                            <DoubleAnimation Storyboard.TargetName="MotionTranslate" Storyboard.TargetProperty="Y" To="1" Duration="{local:MotionDuration Milliseconds=70}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="{local:MotionDuration Milliseconds=100}" />
                                            <DoubleAnimation Storyboard.TargetName="MotionScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{local:MotionDuration Milliseconds=100}" />
                                            <DoubleAnimation Storyboard.TargetName="MotionScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{local:MotionDuration Milliseconds=100}" />
                                            <DoubleAnimation Storyboard.TargetName="MotionTranslate" Storyboard.TargetProperty="Y" To="0" Duration="{local:MotionDuration Milliseconds=100}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0,15" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="MotionRoot" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="MotionTranslate" />
                            </Grid.RenderTransform>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <Border x:Name="HoverChrome" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource ButtonHoverBrush}"
                                    BorderBrush="{DynamicResource AccentBrightBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="{local:MotionDuration Milliseconds=140}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="{local:MotionDuration Milliseconds=120}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MotionTranslate" Storyboard.TargetProperty="Y" To="1" Duration="{local:MotionDuration Milliseconds=70}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MotionTranslate" Storyboard.TargetProperty="Y" To="0" Duration="{local:MotionDuration Milliseconds=100}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardCornerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrightBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource ListSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ProgressBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="1" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                            <Border x:Name="HoverChrome" Opacity="0" Background="{DynamicResource ButtonHoverBrush}" CornerRadius="5" />
                            <Border x:Name="SelectionChrome" Opacity="0" Background="{DynamicResource SelectedItemBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="{local:MotionDuration Milliseconds=120}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="{local:MotionDuration Milliseconds=100}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="{local:MotionDuration Milliseconds=160}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="{local:MotionDuration Milliseconds=100}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Margin="0,4,4,4" CornerRadius="4" Background="{DynamicResource ComboArrowSurfaceBrush}">
                                    <Path Width="9" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stretch="Fill" Fill="{DynamicResource SecondaryBrush}"
                                          Data="M 0 0 L 4.5 5 L 9 0 Z" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Margin="2" Padding="{TemplateBinding Padding}"
                                CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SelectedItemBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8,36,8" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Grid MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Margin="0,4,0,0" Padding="3" CornerRadius="7"
                                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="40" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome" Margin="2" CornerRadius="4"
                                Background="{DynamicResource ScrollThumbBrush}" BorderBrush="{DynamicResource ScrollThumbBorderBrush}" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollThumbDraggingBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalScrollBarThumbStyle" TargetType="Thumb"
               BasedOn="{StaticResource VerticalScrollBarThumbStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="34" />
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="10" Background="{DynamicResource ScrollTrackBrush}">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource VerticalScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="10" Background="{DynamicResource ScrollTrackBrush}">
                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource HorizontalScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ProgressBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5"
                                        Background="{TemplateBinding Foreground}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="7" ShadowDepth="0" Opacity="0.55" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ModeSelectionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SelectionBox" Width="26" Height="26" CornerRadius="4"
                                Background="{DynamicResource ScrollTrackBrush}" BorderBrush="{DynamicResource SelectionBoxBorderBrush}" BorderThickness="1.5">
                            <Path x:Name="SelectionMark" Width="15" Height="11" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 1 5 L 6 10 L 14 1" Stretch="Fill"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectionBox" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartupToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                            <Border x:Name="ToggleTrack" Grid.Column="1" Width="52" Height="28" CornerRadius="14"
                                    Background="{DynamicResource ToggleTrackBrush}" BorderBrush="{DynamicResource ToggleTrackBorderBrush}" BorderThickness="1"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Ellipse x:Name="ToggleThumb" Width="22" Height="22" Margin="2"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource ToggleThumbBrush}"
                                         SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ToggleThumbTranslate" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleThumbTranslate" Storyboard.TargetProperty="X" To="24" Duration="{local:MotionDuration Milliseconds=160}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="{local:MotionDuration Milliseconds=160}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
