    <!-- Parameter hover help: command/configuration key followed by a short purpose. -->
    <sys:String x:Key="ParameterHelp_ContextSizeComboBox" xml:space="preserve">llama.cpp: --ctx-size (-c); Codex: model_context_window&#10;Set the context capacity in K for input, history and generated text; choose within model and hardware limits.</sys:String>
    <sys:String x:Key="ParameterHelp_CustomContextSizeTextBox" xml:space="preserve">llama.cpp: --ctx-size (-c); Codex: model_context_window&#10;Enter a positive whole number in K, for example 96 for 96K (1K=1,024 tokens); stay within the model limit.</sys:String>
    <sys:String x:Key="ParameterHelp_CompactionSafetyReserveComboBox" xml:space="preserve">Codex: model_auto_compact_token_limit = Context - reserve&#10;Enter a positive whole number in K. Reserve context for subsequent processing. The launcher subtracts this reserve from Context to set the compaction threshold, not the per-reply output limit.</sys:String>
    <sys:String x:Key="ParameterHelp_ToolOutputTokenLimitComboBox" xml:space="preserve">Codex: tool_output_token_limit&#10;Enter a positive whole number in K. Limit the token budget for each tool result added to conversation history, not the number of tools per turn. The inherit option preserves the Codex setting.</sys:String>
    <sys:String x:Key="ParameterHelp_CodexStreamIdleTimeoutComboBox" xml:space="preserve">Codex: model_providers.chatgpt_local_launcher.stream_idle_timeout_ms&#10;Set how long a Local response stream may remain idle during replies or compaction. Enter minutes; the stored value is converted to milliseconds.</sys:String>
    <sys:String x:Key="ParameterHelp_ContextShiftCheckBox" xml:space="preserve">llama.cpp: --context-shift / --no-context-shift&#10;Discard earlier context when full to continue generation, potentially forgetting earlier information. This does not perform Codex summary compaction.</sys:String>
    <sys:String x:Key="ParameterHelp_GpuLayersComboBox" xml:space="preserve">llama.cpp: --n-gpu-layers&#10;Choose model layers to offload to the GPU. Auto delegates to the runtime, All tries all offloadable layers, and 0 uses the CPU.</sys:String>
    <sys:String x:Key="ParameterHelp_CustomGpuLayersTextBox" xml:space="preserve">llama.cpp: --n-gpu-layers&#10;Enter a custom non-negative number of model layers to offload to the GPU.</sys:String>
    <sys:String x:Key="ParameterHelp_FlashAttentionComboBox" xml:space="preserve">llama.cpp: --flash-attn&#10;Choose whether to use Flash Attention, which can reduce attention memory overhead when supported. Auto delegates to the runtime.</sys:String>
    <sys:String x:Key="ParameterHelp_CacheTypeKComboBox" xml:space="preserve">llama.cpp: --cache-type-k&#10;Set the K-cache data type. Quantization can save memory but may affect quality and compatibility.</sys:String>
    <sys:String x:Key="ParameterHelp_CacheTypeVComboBox" xml:space="preserve">llama.cpp: --cache-type-v&#10;Set the V-cache data type. Available types also depend on Flash Attention and backend support.</sys:String>
    <sys:String x:Key="ParameterHelp_BatchSizeComboBox" xml:space="preserve">llama.cpp: --batch-size (-b)&#10;Set the logical batch limit for prompt processing. Choose a preset or enter a positive integer; Default or blank inherits runtime defaults.</sys:String>
    <sys:String x:Key="ParameterHelp_MicroBatchSizeComboBox" xml:space="preserve">llama.cpp: --ubatch-size (-ub)&#10;Set the physical batch computed at once, affecting working memory use. When both values are explicit, this must not exceed Batch Size.</sys:String>
    <sys:String x:Key="ParameterHelp_ParallelComboBox" xml:space="preserve">llama.cpp: --parallel&#10;Set concurrent request slots. More slots generally require more KV-cache memory; -1 delegates to the runtime.</sys:String>
    <sys:String x:Key="ParameterHelp_IdleSleepSecondsComboBox" xml:space="preserve">llama.cpp: --sleep-idle-seconds&#10;Unload the model and KV cache after the specified idle seconds; the next request reloads them. -1 disables idle sleep.</sys:String>
    <sys:String x:Key="ParameterHelp_MoePlacementComboBox" xml:space="preserve">llama.cpp: --cpu-moe / --n-cpu-moe&#10;Place all or the first N MoE expert layers on CPU to reduce VRAM demand, possibly at lower speed. Default leaves placement to the runtime.</sys:String>
    <sys:String x:Key="ParameterHelp_CpuMoeLayersTextBox" xml:space="preserve">llama.cpp: --n-cpu-moe&#10;Set how many initial layers keep their MoE experts on CPU; used only with first-N-layers CPU placement.</sys:String>
    <sys:String x:Key="ParameterHelp_MoeLoadModeComboBox" xml:space="preserve">llama.cpp: --load-mode&#10;Choose how model weights are loaded, such as mmap file mapping or mlock memory locking. Default delegates to the runtime.</sys:String>
    <sys:String x:Key="ParameterHelp_MoeFitComboBox" xml:space="preserve">llama.cpp: --fit&#10;Allow runtime loading adjustments to fit available RAM or VRAM; follow model guidance for compatibility.</sys:String>
    <sys:String x:Key="ParameterHelp_JinjaCheckBox" xml:space="preserve">llama.cpp: --jinja / --no-jinja&#10;Choose whether Jinja chat templates format conversations and tools. A template does not by itself verify reasoning, vision or MTP.</sys:String>
    <sys:String x:Key="ParameterHelp_TemplateResourceComboBox" xml:space="preserve">llama.cpp: --chat-template-file&#10;Choose the chat template for this configuration. Built-in selection does not pass an external template file.</sys:String>
    <sys:String x:Key="ParameterHelp_ThinkingEnabledCheckBox" xml:space="preserve">llama.cpp: --reasoning on/off; off: --reasoning-budget 0&#10;Explicitly enable or disable verified thinking mode. Inheriting the template default omits these switches.</sys:String>
    <sys:String x:Key="ParameterHelp_InheritThinkingButton" xml:space="preserve">Launcher: ThinkingEnabled (inherit)&#10;Clear the explicit thinking switch and inherit the template's default behavior.</sys:String>
    <sys:String x:Key="ParameterHelp_ShowThinkingProcessCheckBox" xml:space="preserve">Codex: show_raw_agent_reasoning&#10;Control the display of thinking content without changing whether the model thinks; applied only when thinking is active.</sys:String>
