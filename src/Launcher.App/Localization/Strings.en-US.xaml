    <sys:String x:Key="ModelParameters">Model Parameters</sys:String>
    <sys:String x:Key="ModelParametersHint">Parameters and default snapshots apply only to this model. Saving does not load the model immediately.</sys:String>
    <sys:String x:Key="DisplayName">Display Name</sys:String>
    <sys:String x:Key="DisplayNameTip">Changes only the model name shown in Egg Launcher and ChatGPT.</sys:String>
    <sys:String x:Key="ModelAlias">Model Alias</sys:String>
    <sys:String x:Key="ModelAliasTip">Stable model identifier used by Local Provider requests. It cannot be edited in the basic interface after creation.</sys:String>
    <sys:String x:Key="ModelFile">Model File</sys:String>
    <sys:String x:Key="ModelFileTip">GGUF path relative to the llama.cpp Runtime Root.</sys:String>
    <sys:String x:Key="ModelType">Model Type</sys:String>
    <sys:String x:Key="ModelTypeEditorTip">Model type is detected once when added. Return to Local Model Management to change it.</sys:String>
    <sys:String x:Key="BasicParameters">Basic</sys:String>
    <sys:String x:Key="ContextSelectionTip">Choose according to the model's declared context capacity and available VRAM/RAM. Egg Launcher does not provide hardware-independent recommendations.</sys:String>
    <sys:String x:Key="CustomContextTip">Enter a token count no greater than the model limit and divisible by 256. Values such as 96K are supported.</sys:String>
    <sys:String x:Key="CompactionReserve">Compaction Reserve</sys:String>
    <sys:String x:Key="CompactionReserveTip">Minimum free context reserved before the next inference. Compaction threshold = Context - Reserve. This is not the output token limit for one response.</sys:String>
    <sys:String x:Key="GpuLayersTip">Auto lets llama.cpp decide; All attempts to offload every eligible layer to the GPU; 0 uses the CPU.</sys:String>
    <sys:String x:Key="GpuLayersCustomTip">Enter a non-negative GPU offload layer count.</sys:String>
    <sys:String x:Key="FlashAttentionTip">Can reduce attention memory bandwidth when supported. Use Auto if unsure.</sys:String>
    <sys:String x:Key="KvCacheTip">Quantized KV Cache can reduce VRAM use but may affect quality or compatibility. Select according to the model and hardware.</sys:String>
    <sys:String x:Key="VCacheTip">Flash Attention has requirements for some V Cache types. Select according to the model and hardware.</sys:String>
    <sys:String x:Key="BatchSizeTip">Prompt batch size. Default uses the llama.cpp default.</sys:String>
    <sys:String x:Key="MicroBatchTip">Micro-batch size used for each computation. It must not exceed Batch Size.</sys:String>
    <sys:String x:Key="ParallelSlots">Parallel Slots</sys:String>
    <sys:String x:Key="ParallelSlotsTip">Higher concurrency uses more KV Cache. -1 lets llama.cpp decide.</sys:String>
    <sys:String x:Key="IdleReleaseVram">Release VRAM When Idle</sys:String>
    <sys:String x:Key="IdleReleaseVramTip">Uses native llama.cpp idle sleep to unload the model and KV Cache. The next request reloads automatically.</sys:String>
    <sys:String x:Key="LowContextWarning">⚠ Context below 16K may not fit Codex system instructions, project context, and tool definitions, causing insufficient context during the first conversation or tool use. 16K or higher is recommended. This warning does not block saving or launch.</sys:String>
    <sys:String x:Key="CompactionExplanation">Compaction Reserve controls when Codex triggers native context compaction at a safe point. It does not limit a complete response, tool call, or command token count.</sys:String>
    <sys:String x:Key="EnableJinja">Enable Jinja chat template</sys:String>
    <sys:String x:Key="EnableJinjaTip">Codex/Responses mode usually requires llama.cpp to apply the model chat template.</sys:String>
    <sys:String x:Key="ChatTemplateFile">Chat Template File (Optional)</sys:String>
    <sys:String x:Key="ChatTemplateFileTip">A .jinja file relative to Runtime Root. Leave blank to use the embedded GGUF template. If a strict template is incompatible with Codex, Egg Launcher generates a model-specific compatible file loaded by llama.cpp with --chat-template-file.</sys:String>
    <sys:String x:Key="ExpertPlacement">Expert Placement</sys:String>
    <sys:String x:Key="ExpertPlacementTip">Default does not override llama.cpp. Placing all or the first N expert layers on CPU can reduce VRAM use but usually lowers generation speed.</sys:String>
    <sys:String x:Key="CpuExpertLayers">CPU Expert Layers</sys:String>
    <sys:String x:Key="CpuExpertLayersTip">Enter a positive integer only when Expert Placement is First N Layers on CPU. Keep other modes at default.</sys:String>
    <sys:String x:Key="LoadMode">Load Mode</sys:String>
    <sys:String x:Key="LoadModeTip">Default lets llama.cpp decide. mmap maps the model file through the OS; mlock attempts to lock the model in memory.</sys:String>
    <sys:String x:Key="AutoMemoryFit">Automatic Memory Fit</sys:String>
    <sys:String x:Key="AutoMemoryFitTip">Default does not override llama.cpp. Some special models explicitly require Fit to be disabled; follow the model documentation.</sys:String>
    <sys:String x:Key="ExposeReasoningEffort">Allow reasoning effort selection in ChatGPT</sys:String>
    <sys:String x:Key="ExposeReasoningEffortTip">Available only after llama.cpp explicitly reports a complete set of levels recognized by ChatGPT. Egg Launcher never guesses or emulates reasoning effort.</sys:String>
    <sys:String x:Key="MtpParameters">MTP Decoding</sys:String>
    <sys:String x:Key="VisionParameters">Vision</sys:String>
    <sys:String x:Key="EnableVision">Enable Image Input</sys:String>
    <sys:String x:Key="EnableVisionTip">Available only after llama.cpp passes validation with a real image request.</sys:String>
    <sys:String x:Key="VisionSource">Vision Source</sys:String>
    <sys:String x:Key="VisionProjectorFile">Vision Projector (mmproj)</sys:String>
    <sys:String x:Key="VisionProjectorOffload">Projector GPU Offload</sys:String>
    <sys:String x:Key="VisionProjectorOffloadTip">Leave blank for the llama.cpp default. Turning it off saves VRAM but increases CPU work.</sys:String>
    <sys:String x:Key="VisionDeviceTip">Device used by the vision projector; blank uses the llama.cpp default.</sys:String>
    <sys:String x:Key="VisionImageMinTokensTip">Minimum tokens used for one image; blank uses the llama.cpp default.</sys:String>
    <sys:String x:Key="VisionImageMaxTokensTip">Maximum tokens used for one image; blank uses the llama.cpp default.</sys:String>
    <sys:String x:Key="VisionBatchMaxTokensTip">Multimodal batch token limit; blank uses the llama.cpp default.</sys:String>
    <sys:String x:Key="EnableMtp">Enable MTP</sys:String>
    <sys:String x:Key="EnableMtpTip">Uses native llama.cpp Multi-Token Prediction. Off by default; it is marked verified only after the model loads successfully.</sys:String>
    <sys:String x:Key="MtpSource">MTP Source</sys:String>
    <sys:String x:Key="MtpSourceTip">Embedded means NextN/MTP weights are in the main GGUF. External loads a model-specific companion MTP GGUF.</sys:String>
    <sys:String x:Key="MtpCompanionFile">MTP Companion Model</sys:String>
    <sys:String x:Key="MtpCompanionFileTip">Choose an MTP GGUF under Runtime models that matches the target model version and tokenizer. It is not an arbitrary small draft model.</sys:String>
    <sys:String x:Key="Browse">Browse…</sys:String>
    <sys:String x:Key="Clear">Clear</sys:String>
    <sys:String x:Key="MtpCommonParameters">Common Parameters</sys:String>
    <sys:String x:Key="MtpNMaxTip">Maximum MTP draft tokens generated at once. Leave blank for the llama.cpp default (currently usually 3).</sys:String>
    <sys:String x:Key="MtpNMinTip">Minimum draft tokens generated at once. Leave blank for the llama.cpp default.</sys:String>
    <sys:String x:Key="MtpPMinTip">Minimum draft probability from 0 to 1. Higher values stop uncertain drafts earlier. Leave blank for the default.</sys:String>
    <sys:String x:Key="MtpPSplitTip">Draft branch probability threshold from 0 to 1. Leave blank for the llama.cpp default.</sys:String>
    <sys:String x:Key="MtpBackendSampling">Backend Sampling</sys:String>
    <sys:String x:Key="MtpBackendSamplingTip">Default does not override llama.cpp. Change only for compatibility diagnosis or backend-specific tuning.</sys:String>
    <sys:String x:Key="MtpExternalResources">External MTP Resources</sys:String>
    <sys:String x:Key="MtpGpuLayersTip">GPU offload layers for the external MTP model. Leave blank for llama.cpp automatic placement.</sys:String>
    <sys:String x:Key="MtpDeviceTip">Compute device for the external MTP model. Leave blank for the llama.cpp default.</sys:String>
    <sys:String x:Key="MtpCacheTip">KV Cache type for the external MTP model. Leave blank for the llama.cpp default.</sys:String>
    <sys:String x:Key="MtpThreadsTip">CPU thread count for the external MTP model. Leave blank for llama.cpp to decide.</sys:String>
    <sys:String x:Key="AdvancedParameters">Advanced</sys:String>
    <sys:String x:Key="ModelInformation">Model Info</sys:String>
    <sys:String x:Key="AdvancedParametersHint">Unchanged items remain at default and are not written to the model profile. Advanced parameters can significantly affect compatibility, memory use, and speed.</sys:String>
    <sys:String x:Key="ComputeDevice">Compute Device</sys:String>
    <sys:String x:Key="ComputeDeviceTip">Leave blank for the llama.cpp default device. For multiple devices, enter a comma-separated list in llama.cpp format.</sys:String>
    <sys:String x:Key="KvGpuOffload">KV Cache GPU Offload</sys:String>
    <sys:String x:Key="KvGpuOffloadTip">Default does not override llama.cpp. Disabling can reduce VRAM use but usually lowers speed.</sys:String>
    <sys:String x:Key="CpuGenerationThreads">CPU Generation Threads</sys:String>
    <sys:String x:Key="CpuGenerationThreadsTip">Leave blank for llama.cpp to decide. Set only when limiting or tuning CPU compute.</sys:String>
    <sys:String x:Key="CpuBatchThreads">CPU Batch Threads</sys:String>
    <sys:String x:Key="CpuBatchThreadsTip">Leave blank to follow the generation thread setting. Affects prompt processing.</sys:String>
    <sys:String x:Key="DenseLoadModeTip">Default lets llama.cpp decide. mmap maps files; mlock requires sufficient system memory.</sys:String>
    <sys:String x:Key="LazyMode">Lazy Loading</sys:String>
    <sys:String x:Key="LazyModeTip">Reads supported large tensors on demand. Requires mmap when enabled, and performance depends on SSD speed.</sys:String>
    <sys:String x:Key="AutoMemoryFitFull">Automatic Memory Fit</sys:String>
    <sys:String x:Key="DenseFitTip">Default does not override llama.cpp. Special models may require it to be disabled.</sys:String>
    <sys:String x:Key="FitVramReserve">Fit VRAM Reserve (MiB)</sys:String>
    <sys:String x:Key="FitVramReserveTip">Leave blank for the llama.cpp default. A comma-separated reserve for each device is supported.</sys:String>
    <sys:String x:Key="FitMinimumContext">Fit Minimum Context</sys:String>
    <sys:String x:Key="FitMinimumContextTip">Lowest context automatic fitting may reduce to. Leave blank for the llama.cpp default.</sys:String>
    <sys:String x:Key="CpuDenseFfnLayers">CPU Dense FFN Layers</sys:String>
    <sys:String x:Key="CpuDenseFfnLayersTip">Keep the first N dense FFN layers on CPU. Leave blank to preserve default placement.</sys:String>
    <sys:String x:Key="MultiGpuSplitMode">Multi-GPU Split Mode</sys:String>
    <sys:String x:Key="MultiGpuSplitModeTip">Keep the default for one GPU. Multiple GPUs can split by layer, row, or experimental tensor mode.</sys:String>
    <sys:String x:Key="TensorSplitTip">Multi-GPU allocation ratio, for example 3,1. Leave blank for llama.cpp to decide.</sys:String>
    <sys:String x:Key="MainGpu">Main GPU</sys:String>
    <sys:String x:Key="MainGpuTip">Primary device index for multiple GPUs. Leave blank to use the default device.</sys:String>
    <sys:String x:Key="NumaMode">NUMA Mode</sys:String>
    <sys:String x:Key="NumaModeTip">Keep the default on normal desktops. Select only as needed on NUMA systems.</sys:String>
    <sys:String x:Key="SwaFullCache">Full SWA Cache</sys:String>
    <sys:String x:Key="SwaFullCacheTip">Default does not override. Enabling increases KV memory use on some architectures.</sys:String>
    <sys:String x:Key="ContextCheckpoints">Context Checkpoints</sys:String>
    <sys:String x:Key="ContextCheckpointsTip">llama.cpp --ctx-checkpoints. Leave blank for the Runtime default; 0 disables checkpoints and may reduce long-prefix restore efficiency and increase prefill time. This does not change Codex context compaction.</sys:String>
    <sys:String x:Key="WeightRepack">Weight Repack</sys:String>
    <sys:String x:Key="WeightRepackTip">Default lets llama.cpp decide. Disabling may reduce performance on some backends.</sys:String>
    <sys:String x:Key="OperationOffloadTip">Controls whether host tensor operations are offloaded to the device. Keeping the default is usually safest.</sys:String>
    <sys:String x:Key="BypassHostBuffer">Bypass Host Buffer</sys:String>
    <sys:String x:Key="BypassHostBufferTip">Advanced backend option. Keep the default unless explicitly required by the model or backend documentation.</sys:String>
    <sys:String x:Key="RopeScalingMode">RoPE Scaling Mode</sys:String>
    <sys:String x:Key="RopeScalingModeTip">Adjust only when extending or correcting context. Incorrect settings affect output quality.</sys:String>
