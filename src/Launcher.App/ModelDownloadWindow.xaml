<Window x:Class="Launcher.App.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SearchGgufTitle}"
        Icon="Assets/egg-mark.png"
        Height="720"
        Width="820"
        MinHeight="480"
        MinWidth="640"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid Margin="28" Background="Transparent"
          PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                           Text="{DynamicResource SearchHuggingFaceGguf}" />
                <Border Margin="12,2,0,0" Padding="9,4" CornerRadius="8" Background="{DynamicResource WarningBackgroundBrush}">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}"
                               Text="{DynamicResource ExperimentalFeature}" />
                </Border>
            </StackPanel>
            <TextBlock Margin="0,6,0,14" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"
                       Text="{DynamicResource SearchGgufDescription}" />
            <Border Background="{DynamicResource InputSurfaceBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Padding="10,8" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0"
                         KeyDown="SearchTextBox_KeyDown" />
                <Button x:Name="SearchButton" Grid.Column="1" Margin="6,4,4,4" Padding="18,7"
                        Content="{DynamicResource Search}" Click="SearchButton_Click" />
            </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
        <Grid Height="190">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" Text="{DynamicResource SearchResults}" />
            <Border Grid.Row="1" Margin="0,8,0,0"
                    Background="{DynamicResource InputSurfaceBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="SearchResultsList" Background="Transparent" BorderThickness="0"
                             DisplayMemberPath="Summary"
                             SelectionChanged="SearchResultsList_SelectionChanged" />
                    <Border Grid.Column="1" Background="{DynamicResource InputBorderBrush}" />
                    <ScrollViewer Grid.Column="2" Padding="14"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ModelDetailsText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   Text="{DynamicResource SelectRepositoryHint}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Margin="0,16,0,8" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryBrush}" Text="{DynamicResource DownloadableGgufVersions}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="82" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="82" />
            </Grid.RowDefinitions>
            <ListBox x:Name="VariantsList" MinHeight="70" MaxHeight="150"
                     Background="{DynamicResource InputSurfaceBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     DisplayMemberPath="Summary" SelectionChanged="VariantsList_SelectionChanged" />
            <TextBlock Grid.Row="1" Margin="0,12,0,7" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" Text="{DynamicResource DownloadableMtpFiles}" />
            <ListBox x:Name="MtpFilesList" Grid.Row="2" MinHeight="54" MaxHeight="100"
                     Background="{DynamicResource InputSurfaceBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     DisplayMemberPath="Summary" SelectionChanged="MtpFilesList_SelectionChanged" />
            <TextBlock Grid.Row="3" Margin="0,12,0,7" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" Text="{DynamicResource DownloadableVisionFiles}" />
            <ListBox x:Name="VisionFilesList" Grid.Row="4" MinHeight="54" MaxHeight="100"
                     Background="{DynamicResource InputSurfaceBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     DisplayMemberPath="Summary" SelectionChanged="VisionFilesList_SelectionChanged" />
        </Grid>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="14" CornerRadius="10" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel>
                <ProgressBar x:Name="DownloadProgressBar" Height="16" Minimum="0" Maximum="100" />
                <TextBlock x:Name="DownloadProgressText" Margin="0,9,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryBrush}"
                           Text="{DynamicResource DownloadNotStarted}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource Ready}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenRepositoryButton" Padding="13,9" IsEnabled="False"
                        ToolTip="{DynamicResource OpenCurrentRepositoryToolTip}"
                        AutomationProperties.Name="{DynamicResource OpenCurrentRepository}"
                        Click="OpenRepositoryButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource OpenCurrentRepository}" />
                        <ContentControl Width="14" Height="14" Margin="6,0,0,0"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        ContentTemplate="{StaticResource ExternalLinkIconTemplate}" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenVariantButton" Padding="13,9" IsEnabled="False"
                        ToolTip="{DynamicResource OpenCurrentVersionToolTip}"
                        AutomationProperties.Name="{DynamicResource OpenCurrentVersion}"
                        Click="OpenVariantButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource OpenCurrentVersion}" />
                        <ContentControl Width="14" Height="14" Margin="6,0,0,0"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        ContentTemplate="{StaticResource ExternalLinkIconTemplate}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelDownloadButton" Padding="18,9" Content="{DynamicResource CancelDownload}"
                        IsEnabled="False" Visibility="Collapsed" Click="CancelDownloadButton_Click" />
                <Button x:Name="DownloadButton" Padding="18,9" Content="{DynamicResource CreateDownloadTask}"
                        IsEnabled="False" Click="DownloadButton_Click" />
                <Button x:Name="CloseButton" Margin="0" Padding="18,9" Content="{DynamicResource Close}" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
