<Window x:Class="Launcher.App.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索并下载 GGUF 模型（实验性）"
        Height="720"
        Width="820"
        MinHeight="620"
        MinWidth="720"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                           Text="从 Hugging Face 搜索 GGUF" />
                <Border Margin="12,2,0,0" Padding="9,4" CornerRadius="8" Background="#FFF7E6">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#7A4B00"
                               Text="实验性功能" />
                </Border>
            </StackPanel>
            <TextBlock Margin="0,6,0,14" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"
                       Text="请输入较准确的模型名称。搜索只读取公开元数据；下载、缓存与分片处理均由 llama.cpp 完成。功能可能受 Runtime 构建和网络环境影响，失败不会影响其他核心功能。" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Padding="10,8" VerticalContentAlignment="Center"
                         KeyDown="SearchTextBox_KeyDown" />
                <Button x:Name="SearchButton" Grid.Column="1" Margin="12,0,0,0" Padding="18,9"
                        Content="搜索" Click="SearchButton_Click" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="14" CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="SearchResultsList" DisplayMemberPath="Summary"
                         SelectionChanged="SearchResultsList_SelectionChanged" />
                <TextBlock x:Name="ModelDetailsText" Grid.Column="2" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryBrush}"
                           Text="搜索后选择一个模型仓库。" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,16,0,8" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}" Text="可下载的 GGUF 量化版本" />

        <ListBox x:Name="VariantsList" Grid.Row="3" MinHeight="90" MaxHeight="170"
                 DisplayMemberPath="Summary" SelectionChanged="VariantsList_SelectionChanged" />

        <Border Grid.Row="4" Margin="0,16,0,0" Padding="14" CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}">
            <StackPanel>
                <ProgressBar x:Name="DownloadProgressBar" Height="16" Minimum="0" Maximum="100" />
                <TextBlock x:Name="DownloadProgressText" Margin="0,9,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryBrush}"
                           Text="尚未开始下载。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryBrush}" Text="准备就绪。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelDownloadButton" Padding="18,9" Content="取消下载"
                        IsEnabled="False" Click="CancelDownloadButton_Click" />
                <Button x:Name="DownloadButton" Padding="18,9" Content="下载选中版本"
                        IsEnabled="False" Click="DownloadButton_Click" />
                <Button x:Name="CloseButton" Padding="18,9" Content="关闭" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
