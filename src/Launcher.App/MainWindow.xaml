<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launcher.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Egg Launcher"
        Icon="Assets/egg-mark.png"
        Width="1360" Height="820" MinWidth="840" MinHeight="520"
        Background="{DynamicResource WindowGradientBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" DpiChanged="Window_DpiChanged"
        StateChanged="Window_StateChanged" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Tag" Value="{DynamicResource TitleButtonHoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="HoverChrome" Background="{TemplateBinding Tag}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="{local:MotionDuration Milliseconds=120}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="{local:MotionDuration Milliseconds=100}" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Tag" Value="{DynamicResource TitleCloseHoverBrush}" />
        </Style>
        <Style x:Key="NotificationDismissButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DismissChrome" CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DismissChrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="DismissChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DismissChrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="MainWindowChrome" CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="0" Background="{DynamicResource WindowGradientBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="MinimizeButtonColumn" Width="40" />
                    <ColumnDefinition x:Name="MaximizeButtonColumn" Width="40" />
                    <ColumnDefinition x:Name="CloseButtonColumn" Width="40" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="24" Height="24" Source="Assets/egg-mark-title.png" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" UseLayoutRounding="True" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Egg Launcher" />
                    <TextBlock x:Name="HeaderVersionText" Margin="12,2,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Text="0.9.1" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}"
                        Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Canvas Width="12" Height="12" SnapsToDevicePixels="True">
                        <Path Data="M 1,6 L 11,6" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1"
                              StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Canvas>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TitleBarButtonStyle}"
                        Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Canvas Width="12" Height="12" SnapsToDevicePixels="True">
                        <Rectangle Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                                   Fill="Transparent" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1" />
                    </Canvas>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Canvas Width="12" Height="12" SnapsToDevicePixels="True">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1"
                              StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Canvas>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="292" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Fixed sidebar -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderThickness="0" CornerRadius="0">
                    <Grid x:Name="SidebarLayoutGrid" Margin="18,14,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="SidebarBrandPanel" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Image x:Name="SidebarLogoImage" Width="96" Height="96" Source="Assets/egg-mark-display.png" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True" UseLayoutRounding="True" />
                            <TextBlock x:Name="SidebarBrandText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="Egg Launcher" />
                            <TextBlock x:Name="SidebarSubtitleText" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource AppSubtitle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Button x:Name="HomeNavButton" Style="{StaticResource NavButtonStyle}" Click="HomeNavButton_Click">
                                <Grid>
                                    <ContentControl x:Name="HomeNavIcon" Width="22" Height="22" Margin="24,0,0,0"
                                                    HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryBrush}"
                                                    ContentTemplate="{StaticResource HomeIconTemplate}" />
                                    <TextBlock x:Name="HomeNavText" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource Home}" />
                                </Grid>
                            </Button>
                            <Button x:Name="ModeNavButton" Style="{StaticResource NavButtonStyle}" Click="ModeNavButton_Click">
                                <Grid>
                                    <ContentControl x:Name="ModeNavIcon" Width="22" Height="22" Margin="24,0,0,0"
                                                    HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryBrush}"
                                                    ContentTemplate="{StaticResource ModeIconTemplate}" />
                                    <TextBlock x:Name="ModeNavText" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource Mode}" />
                                </Grid>
                            </Button>
                            <Button x:Name="ModelsNavButton" Style="{StaticResource NavButtonStyle}" Click="ModelsNavButton_Click">
                                <Grid>
                                    <ContentControl x:Name="ModelsNavIcon" Width="22" Height="22" Margin="24,0,0,0"
                                                    HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryBrush}"
                                                    ContentTemplate="{StaticResource ModelsIconTemplate}" />
                                    <TextBlock x:Name="ModelsNavText" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource Models}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="SidebarFooterPanel" Grid.Row="3">
                            <Separator Margin="8,0,8,14" Background="{DynamicResource LineBrush}" />
                            <TextBlock Margin="8,0" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource Signature}" />
                            <TextBlock Margin="8,6,8,14" Foreground="{DynamicResource AccentBrush}" FontSize="14" Text="More AI, More Burnout." />
                            <UniformGrid x:Name="SidebarPerformanceGrid" Columns="4" Margin="2,0,2,12">
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="CPU" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/><Grid Width="48" Height="48" Margin="0,6,0,0"><local:CircularProgressRing x:Name="SidebarCpuRing" TrackBrush="{DynamicResource PerformanceRingTrackBrush}" ProgressBrush="{DynamicResource PerformanceRingProgressBrush}"/><TextBlock x:Name="SidebarCpuText" FontSize="12" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="{DynamicResource Memory}" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/><Grid Width="48" Height="48" Margin="0,6,0,0"><local:CircularProgressRing x:Name="SidebarMemoryRing" TrackBrush="{DynamicResource PerformanceRingTrackBrush}" ProgressBrush="{DynamicResource PerformanceRingProgressBrush}"/><TextBlock x:Name="SidebarMemoryText" FontSize="12" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="GPU" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/><Grid Width="48" Height="48" Margin="0,6,0,0"><local:CircularProgressRing x:Name="SidebarGpuRing" TrackBrush="{DynamicResource PerformanceRingTrackBrush}" ProgressBrush="{DynamicResource PerformanceRingProgressBrush}"/><TextBlock x:Name="SidebarGpuText" FontSize="12" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="{DynamicResource Vram}" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/><Grid Width="48" Height="48" Margin="0,6,0,0"><local:CircularProgressRing x:Name="SidebarVramRing" TrackBrush="{DynamicResource PerformanceRingTrackBrush}" ProgressBrush="{DynamicResource PerformanceRingProgressBrush}"/><TextBlock x:Name="SidebarVramText" FontSize="12" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></StackPanel>
                            </UniformGrid>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{DynamicResource Speed}" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="SidebarSpeedText" Margin="0,4,0,0" FontSize="15" Text="–"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="{DynamicResource Context}" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="SidebarContextText" Margin="0,4,0,0" FontSize="15" Text="–"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right content -->
                <Grid x:Name="MainContentGrid" Grid.Column="1" Margin="28,22,28,20">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <TabControl x:Name="LauncherTabs" Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabPanel"><Setter Property="Visibility" Value="Collapsed" /></Style>
                            <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                        </TabControl.Resources>

                        <!-- Home -->
                        <TabItem x:Name="HomeTab">
                            <ScrollViewer x:Name="HomeScrollViewer" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="32" FontWeight="SemiBold" Text="{DynamicResource Home}" />
                                    <Grid x:Name="HomeCardsGrid" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                                        <Border x:Name="LaunchCard" Style="{StaticResource CardStyle}" Margin="0,0,8,8" MinHeight="236">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource LaunchIconTemplate}" />
                                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource LaunchChatGpt}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                    <Button x:Name="LaunchChatGptButton" Margin="72,0" Style="{StaticResource PrimaryActionButton}" Content="{DynamicResource LaunchChatGpt}" Click="LaunchChatGptButton_Click" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="{DynamicResource LaunchHint}" />
                                            </Grid>
                                        </Border>

                                        <Border x:Name="HardwareCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,8" MinHeight="236">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource HardwareIconTemplate}" />
                                                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource DeviceHardware}"/>
                                                    </StackPanel>
                                                    <Button x:Name="RefreshHardwareButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CardCornerIconButtonStyle}" ToolTip="{DynamicResource RefreshHardware}" Click="RefreshHardwareButton_Click">
                                                        <ContentControl x:Name="RefreshHardwareIcon" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" ContentTemplate="{StaticResource RefreshIconTemplate}" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock x:Name="HardwareInventoryText" Margin="44,20,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="27" Text="{DynamicResource ReadingHardware}" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="CurrentStateCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,8,0" MinHeight="222">
                                            <StackPanel Grid.IsSharedSizeScope="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource StatusIconTemplate}" />
                                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource CurrentStatus}"/>
                                                </StackPanel>
                                                <Grid Margin="44,18,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CurrentStateLabel" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="16" Text="{DynamicResource CurrentMode}" />
                                                    <TextBlock x:Name="CurrentModeText" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="16" Text="{DynamicResource Reading}" />
                                                </Grid>
                                                <Grid Margin="44,10,0,0" TextElement.Foreground="{DynamicResource SecondaryBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CurrentStateLabel" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" MinHeight="26" />
                                                        <RowDefinition Height="Auto" MinHeight="26" />
                                                        <RowDefinition Height="Auto" MinHeight="26" />
                                                        <RowDefinition Height="Auto" MinHeight="26" />
                                                        <RowDefinition Height="Auto" MinHeight="26" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="ChatGPT" />
                                                    <TextBlock x:Name="ChatGptStatusText" Grid.Column="1" Margin="18,0,0,0" Text="{DynamicResource Reading}" />
                                                    <TextBlock Grid.Row="1" Text="{DynamicResource ConfigurationStatus}" />
                                                    <TextBlock x:Name="ConfigurationStatusText" Grid.Row="1" Grid.Column="1" Margin="18,0,0,0" Text="{DynamicResource Reading}" />
                                                    <TextBlock Grid.Row="2" Text="{DynamicResource LlamaService}" />
                                                    <TextBlock x:Name="LlamaRuntimeText" Grid.Row="2" Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" Text="{DynamicResource Reading}" />
                                                    <TextBlock Grid.Row="3" Text="{DynamicResource LlamaBackend}" />
                                                    <TextBlock x:Name="LlamaBackendText" Grid.Row="3" Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" Text="–" />
                                                    <TextBlock Grid.Row="4" Text="{DynamicResource RunningModel}" />
                                                    <TextBlock x:Name="RunningModelText" Grid.Row="4" Grid.Column="1" Margin="18,0,0,0" Text="–" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="SettingsCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,8,0,0" MinHeight="222">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource SettingsIconTemplate}" />
                                                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource Settings}"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <Button x:Name="LanguageToggleButton" Margin="0,0,8,0" Style="{StaticResource CardCornerIconButtonStyle}"
                                                                ToolTip="{DynamicResource SwitchLanguageToolTip}" Click="LanguageToggleButton_Click">
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="{DynamicResource FollowSystemLanguage}"
                                                                              Click="FollowSystemLanguageMenuItem_Click" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{DynamicResource LanguageCode}" />
                                                        </Button>
                                                        <Button x:Name="ThemeToggleButton" Style="{StaticResource CardCornerIconButtonStyle}" IsEnabled="False"
                                                                ToolTip="{DynamicResource SwitchToLightTheme}" Click="ThemeToggleButton_Click">
                                                            <ContentControl x:Name="ThemeToggleIcon" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"
                                                                            ContentTemplate="{StaticResource LightbulbOffIconTemplate}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Height="28" Margin="44,18,22,0">
                                                    <CheckBox x:Name="StartAgentAtLoginCheckBox" Margin="0" FontSize="16"
                                                              Style="{StaticResource StartupToggleStyle}"
                                                              Content="{DynamicResource StartAtLogin}"
                                                              Click="StartAgentAtLoginCheckBox_Click" />
                                                </Grid>
                                                <Button x:Name="OpenLogsButton" Margin="44,18,120,0" Content="{DynamicResource DiagnosticLogs}" Click="OpenLogsButton_Click" />
                                                <Button Margin="44,8,120,0" Content="{DynamicResource AboutEggLauncher}" Click="AboutButton_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Mode selection -->
                        <TabItem x:Name="LocalModelsTab">
                            <ScrollViewer x:Name="LocalModelsScrollViewer" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseLeftButtonDown="ModePage_PreviewMouseLeftButtonDown">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock FontSize="32" FontWeight="SemiBold" Text="{DynamicResource Mode}" />
                                        <TextBlock x:Name="ModePageHintText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource ModePageHint}" />
                                    </Grid>
                                    <ItemsControl x:Name="ModeModelsItemsControl" Margin="0,18,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="390" Height="240" Padding="18" Margin="0,0,14,14"
                                                        Tag="{Binding Profile}" AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="ModeCard_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="ModeCard_PreviewMouseMove"
                                                        Drop="ModeCard_Drop"
                                                        MouseLeftButtonUp="ModeCard_MouseLeftButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Background" Value="{DynamicResource ModePendingCardBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Opacity="{Binding Opacity}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="28" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="38" />
                                                        </Grid.RowDefinitions>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl Width="28" Height="28" Foreground="{DynamicResource AccentBrightBrush}">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource LocalModelIconTemplate}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOpenAi}" Value="True">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource OpenAiIconTemplate}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                       FontSize="20" FontWeight="SemiBold" Text="{Binding CardTitle}" />
                                                            <CheckBox Grid.Column="2" VerticalAlignment="Top"
                                                                      Style="{StaticResource ModeSelectionCheckBoxStyle}"
                                                                      IsChecked="{Binding IsPending, Mode=OneWay}" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" Tag="{Binding Profile}" Margin="10,10,10,0"
                                                                   HorizontalAlignment="Center" MaxWidth="310"
                                                                   FontSize="18" FontWeight="SemiBold"
                                                                   Text="{Binding ModelName}" ToolTip="{Binding ModelName}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   MouseLeftButtonUp="ModeCardName_MouseLeftButtonUp" />

                                                        <Grid Grid.Row="2" Margin="0,10,0,6" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" Visibility="{Binding LocalDetailsVisibility}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="82" />
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="82" />
                                                                <ColumnDefinition Width="58" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="27" />
                                                                <RowDefinition Height="27" />
                                                                <RowDefinition Height="27" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ModeParameterLabelStyle}" Text="{Binding LeftLabel1}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ModeParameterValueStyle}" Text="{Binding LeftValue1}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource ModeParameterLabelStyle}" Text="{Binding RightLabel1}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource ModeParameterValueStyle}" Text="{Binding RightValue1}" />

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModeParameterLabelStyle}" Text="{Binding LeftLabel2}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModeParameterValueStyle}" Text="{Binding LeftValue2}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ModeParameterLabelStyle}" Text="{Binding RightLabel2}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource ModeParameterValueStyle}" Text="{Binding RightValue2}" />

                                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModeParameterLabelStyle}" Text="{Binding LeftLabel3}" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModeParameterValueStyle}" Text="{Binding LeftValue3}" />
                                                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource ModeParameterLabelStyle}" Text="{Binding RightLabel3}" />
                                                            <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource ModeParameterValueStyle}" Text="{Binding RightValue3}" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="2" Margin="24,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontSize="16" Foreground="{DynamicResource SecondaryBrush}"
                                                                   Text="{Binding Summary}" Visibility="{Binding OpenAiDetailsVisibility}" />

                                                        <Button Grid.Row="3" Tag="{Binding Profile}" HorizontalAlignment="Center"
                                                                MinWidth="176" Height="38" Padding="12,6" Margin="0" FontSize="16" Content="{DynamicResource Configure}"
                                                                Visibility="{Binding SettingsVisibility}" IsEnabled="{Binding CanEdit}" Click="ModeCardSettings_Click" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Models -->
                        <TabItem x:Name="RuntimeMonitorTab">
                            <ScrollViewer x:Name="RuntimeMonitorScrollViewer" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="32" FontWeight="SemiBold" Text="{DynamicResource Models}" />
                                    <Grid x:Name="ModelCardsGrid" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                                        <Border x:Name="RuntimeCard" Style="{StaticResource CardStyle}" Margin="0,0,8,8" MinHeight="210">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource RuntimeIconTemplate}" />
                                                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="llama.cpp" />
                                                    </StackPanel>
                                                    <Button x:Name="OpenLlamaDownloadsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Style="{StaticResource CardCornerIconButtonStyle}"
                                                            ToolTip="{DynamicResource OpenLlamaDownload}"
                                                            AutomationProperties.Name="{DynamicResource OpenLlamaDownload}"
                                                            Click="OpenLlamaDownloadsButton_Click">
                                                        <ContentControl Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}"
                                                                        ContentTemplate="{StaticResource ExternalLinkIconTemplate}" />
                                                    </Button>
                                                </Grid>
                                                <Button x:Name="SelectRuntimeButton" Margin="40,28,40,0" Content="{DynamicResource SelectFolder}" Click="SelectRuntimeButton_Click" />
                                                <TextBox x:Name="RuntimePathText" Margin="0,20,0,0" IsReadOnly="True" />
                                                <TextBlock x:Name="RuntimeStatusText" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Text="{DynamicResource RuntimeNotConfigured}" />
                                                <TextBlock x:Name="DeviceText" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="ManageModelsCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,8" MinHeight="210">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource ManageModelsIconTemplate}" />
                                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource ManageLocalModels}" />
                                                </StackPanel>
                                                <Button Margin="40,28,40,0" Content="{DynamicResource OpenModelManagement}" Click="ManageModelsButton_Click" />
                                                <TextBlock Margin="0,20,0,0" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource ManageLocalModelsDescription}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="SearchModelsCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,8,0" MinHeight="190">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource SearchModelsIconTemplate}" />
                                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource SearchModels}" />
                                                </StackPanel>
                                                <Button x:Name="SearchDownloadButton" Margin="40,28,40,0" Content="{DynamicResource SearchCommunityModels}" Click="SearchDownloadButton_Click" />
                                                <TextBlock Margin="0,18,0,0" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource SearchModelsDescription}" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="DownloadsCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,8,0,0" MinHeight="190">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="30" Height="30" Foreground="{DynamicResource AccentBrightBrush}" ContentTemplate="{StaticResource DownloadIconTemplate}" />
                                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource DownloadManagement}" />
                                                </StackPanel>
                                                <Button Margin="40,28,40,0" Content="{DynamicResource OpenDownloadManagement}" Click="DownloadManagerButton_Click" />
                                                <TextBlock x:Name="DownloadStatusSummaryText" Margin="0,18,0,0" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource NoActiveDownload}" />
                                                <ProgressBar x:Name="MainDownloadProgressBar" Margin="0,10,0,0" Height="10" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border x:Name="ModelManagementPanel" Margin="0,18,0,0" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid><TextBlock FontSize="21" FontWeight="SemiBold" Text="{DynamicResource LocalModelManagement}"/><Button HorizontalAlignment="Right" Content="{DynamicResource Close}" Click="CloseModelManagementButton_Click"/></Grid>
                                            <Button x:Name="ScanModelsButton" Margin="0,16,0,0" HorizontalAlignment="Left" Content="{DynamicResource ScanLocalModels}" Click="ScanModelsButton_Click" />
                                            <TextBlock Margin="0,12,0,6" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource NotAdded}" />
                                            <ListBox x:Name="DiscoveredModelsList" MinHeight="70" MaxHeight="140" DisplayMemberPath="Summary" SelectionChanged="DiscoveredModelsList_SelectionChanged" />
                                            <Button x:Name="AddModelButton" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{DynamicResource AddAndShow}" Click="AddModelButton_Click" />
                                            <TextBlock Margin="0,18,0,6" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource ManagedModels}" />
                                            <ListBox x:Name="ManagedModelsList" MinHeight="90" MaxHeight="180" SelectionChanged="ManagedModelsList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.46" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="SelectedModelDetailsText" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="EditModelButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource EditParameters}" ToolTip="{DynamicResource EditModelToolTip}"
                                                        Click="EditModelButton_Click" />
                                                <Button x:Name="ChangeModelTypeButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource ChangeModelType}" ToolTip="{DynamicResource ChangeModelTypeToolTip}"
                                                        Click="ChangeModelTypeButton_Click" />
                                                <Button x:Name="ModelDetailsButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource ModelDetails}" ToolTip="{DynamicResource ModelDetailsToolTip}"
                                                        Click="ModelDetailsButton_Click" />
                                                <Button x:Name="DetectReasoningCapabilityButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource DetectReasoningCapability}" ToolTip="{DynamicResource DetectReasoningCapabilityToolTip}"
                                                        Click="DetectReasoningCapabilityButton_Click" />
                                                <Button x:Name="LoadExternalMtpButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource LoadExternalMtp}" ToolTip="{DynamicResource LoadExternalMtpToolTip}"
                                                        Click="LoadExternalMtpButton_Click" />
                                                <Button x:Name="RemoveExternalMtpButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource RemoveExternalMtp}" ToolTip="{DynamicResource RemoveExternalMtpToolTip}"
                                                        Click="RemoveExternalMtpButton_Click" />
                                                <Button x:Name="LoadExternalVisionButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource LoadExternalVision}" ToolTip="{DynamicResource LoadExternalVisionToolTip}"
                                                        Click="LoadExternalVisionButton_Click" />
                                                <Button x:Name="RemoveExternalVisionButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource RemoveExternalVision}" ToolTip="{DynamicResource RemoveExternalVisionToolTip}"
                                                        Click="RemoveExternalVisionButton_Click" />
                                                <Button x:Name="ToggleModelVisibilityButton" Margin="0,0,8,8" Padding="12,8" FontSize="13"
                                                        Content="{DynamicResource ShowOrHide}" ToolTip="{DynamicResource ShowOrHideToolTip}"
                                                        Click="ToggleModelVisibilityButton_Click" />
                                                <Button x:Name="DeleteLocalModelButton" Margin="0,0,0,8" Padding="12,8" FontSize="13"
                                                        Style="{StaticResource DangerActionButton}" Content="{DynamicResource DeleteModelAndConfig}"
                                                        ToolTip="{DynamicResource DeleteModelAndConfigToolTip}" Click="DeleteLocalModelButton_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="DownloadManagementPanel" Margin="0,18,0,0" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid><TextBlock FontSize="21" FontWeight="SemiBold" Text="{DynamicResource DownloadCacheManagement}"/><Button HorizontalAlignment="Right" Content="{DynamicResource Close}" Click="CloseDownloadManagerButton_Click"/></Grid>
                                            <TextBlock x:Name="ActiveDownloadDetailsText" Margin="0,16,0,0" Foreground="{DynamicResource SecondaryBrush}" Text="{DynamicResource NoActiveDownload}" TextWrapping="Wrap" />
                                            <ProgressBar x:Name="DownloadManagerProgressBar" Margin="0,10,0,0" Height="14" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                                            <Button x:Name="CancelActiveDownloadButton" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{DynamicResource CancelCurrentDownload}" IsEnabled="False" Click="CancelActiveDownloadButton_Click" />
                                            <ListBox x:Name="DownloadTasksList" Margin="0,12,0,0" MinHeight="70" MaxHeight="130"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="4,2" Text="{Binding}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button x:Name="RefreshCacheButton" Margin="0,16,0,0" HorizontalAlignment="Left" Content="{DynamicResource RefreshCache}" Click="RefreshCacheButton_Click" />
                                            <ListBox x:Name="CachedModelsList" Margin="0,10,0,0" MinHeight="90" MaxHeight="180"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     SelectionChanged="CachedModelsList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="4,2" Text="{Binding Summary}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button x:Name="DeleteCachedModelButton" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{DynamicResource DeleteSelectedCache}" Click="DeleteCachedModelButton_Click" />
                                            <TextBlock x:Name="CacheStatusText" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Retained non-visible capabilities -->
                                    <StackPanel Visibility="Collapsed">
                                        <Button x:Name="OpenAiModeButton" Tag="OpenAI" Click="ModeButton_Click" />
                                        <Button x:Name="LocalModeButton" Tag="Local" Click="ModeButton_Click" />
                                        <Button x:Name="ActivateLocalButton" Click="ActivateLocalButton_Click" />
                                        <Button x:Name="AutoFitModelButton" Click="AutoFitModelButton_Click" />
                                        <Button x:Name="RefreshMonitoringButton" Click="RefreshMonitoringButton_Click" />
                                        <Button x:Name="LoadCurrentModelButton" Click="LoadCurrentModelButton_Click" />
                                        <Button x:Name="UnloadCurrentModelButton" Click="UnloadCurrentModelButton_Click" />
                                        <TextBlock x:Name="SystemPerformanceText" />
                                        <TextBlock x:Name="AboutVersionText" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border x:Name="StatusNotificationBar" Grid.Row="1" Margin="0,16,0,0" Padding="14,9" CornerRadius="9" Background="{DynamicResource NotificationBackgroundBrush}" BorderBrush="{DynamicResource NotificationBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrightBrush}" Text="ⓘ" FontSize="16" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Text="{DynamicResource Ready}" />
                            <Button Grid.Column="2" Style="{StaticResource NotificationDismissButtonStyle}" ToolTip="{DynamicResource DismissNotification}" Click="DismissStatusButton_Click">
                                <Canvas Width="10" Height="10" SnapsToDevicePixels="True">
                                    <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
