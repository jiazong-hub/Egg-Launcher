<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ChatGPT Local Launcher"
        Height="780"
        Width="980"
        MinHeight="600"
        MinWidth="760"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                       Text="ChatGPT Local Launcher" />
            <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource SecondaryBrush}"
                       Text="ChatGPT Desktop × llama.cpp · 安全配置与模型管理" />
            <TextBlock x:Name="HeaderVersionText" Margin="0,4,0,0" FontSize="12"
                       Foreground="{StaticResource SecondaryBrush}" Text="公测版" />
        </StackPanel>

        <TabControl x:Name="LauncherTabs" Grid.Row="1" Margin="0,24,0,20">
            <TabItem Header="首页">
                <Border Margin="0,12,0,0" Padding="28" CornerRadius="14"
                        Background="{StaticResource CardBackgroundBrush}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="{StaticResource SecondaryBrush}"
                                   Text="当前持久化模式" />
                        <TextBlock x:Name="CurrentModeText" Margin="0,6,0,24" FontSize="24"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                   Text="正在读取…" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenAiModeButton" Content="OpenAI" Tag="OpenAI"
                                    Click="ModeButton_Click" />
                            <Button x:Name="LocalModeButton" Content="Local LLM" Tag="Local"
                                    Click="ModeButton_Click" />
                        </StackPanel>

                        <Separator Margin="0,26,0,20" />
                        <TextBlock x:Name="EnvironmentText" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryBrush}" />
                        <CheckBox x:Name="StartAgentAtLoginCheckBox" Margin="0,18,0,0"
                                  Content="登录 Windows 时启动后台 Agent"
                                  Click="StartAgentAtLoginCheckBox_Click" />
                        <TextBlock x:Name="AgentStartupText" Margin="24,5,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   Text="正在检查 Agent 登录启动项…" />
                        <Button x:Name="OpenLogsButton" Margin="0,14,0,0" Padding="16,8"
                                HorizontalAlignment="Left" Content="打开诊断日志文件夹"
                                Click="OpenLogsButton_Click" />
                        <Border Margin="0,22,0,0" Padding="14" CornerRadius="8" Background="#FFF7E6">
                            <TextBlock Foreground="#7A4B00" TextWrapping="Wrap"
                                       Text="ChatGPT Desktop 运行时禁止模式切换。当前开发会话保持 OpenAI；请在之后的真机验收中关闭客户端再测试。" />
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="LocalModelsTab" Header="本地模型">
                <ScrollViewer x:Name="LocalModelsScrollViewer" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="22" CornerRadius="14" Background="{StaticResource CardBackgroundBrush}">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="llama.cpp Runtime" />
                                <TextBlock Margin="0,5,0,14" Foreground="{StaticResource SecondaryBrush}"
                                           Text="目录中必须包含 llama-server.exe。验证成功后才会保存。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RuntimePathText" Padding="10,8" IsReadOnly="True"
                                             VerticalContentAlignment="Center" />
                                    <Button x:Name="SelectRuntimeButton" Grid.Column="1" Margin="12,0,0,0"
                                            Padding="18,9" Content="选择文件夹" Click="SelectRuntimeButton_Click" />
                                </Grid>
                                <TextBlock x:Name="RuntimeStatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}" Text="尚未配置 Runtime。" />
                                <TextBlock x:Name="DeviceText" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}" />
                                <Button x:Name="SearchDownloadButton" Margin="0,14,0,0" Padding="18,9"
                                        HorizontalAlignment="Left" Content="搜索并下载 GGUF（实验性）"
                                        IsEnabled="False" Click="SearchDownloadButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="22" CornerRadius="14"
                                Background="{StaticResource CardBackgroundBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" Text="扫描结果" />
                                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryBrush}"
                                                   Text="扫描不会自动启用模型；请选择后手动添加。" />
                                    </StackPanel>
                                    <Button x:Name="ScanModelsButton" Grid.Column="1" Margin="12,0,0,0"
                                            Padding="18,9" Content="扫描模型" IsEnabled="False"
                                            Click="ScanModelsButton_Click" />
                                </Grid>
                                <ListBox x:Name="DiscoveredModelsList" Margin="0,14,0,12" MinHeight="82"
                                         MaxHeight="150" DisplayMemberPath="Summary"
                                         PreviewMouseWheel="NestedList_PreviewMouseWheel"
                                         SelectionChanged="DiscoveredModelsList_SelectionChanged" />
                                <Button x:Name="AddModelButton" HorizontalAlignment="Left" Padding="18,9"
                                        Content="添加选中模型" IsEnabled="False" Click="AddModelButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="22" CornerRadius="14"
                                Background="{StaticResource CardBackgroundBrush}">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="已管理模型" />
                                <TextBlock Margin="0,5,0,10" Foreground="{StaticResource SecondaryBrush}"
                                           Text="Profile 保存在 llama.cpp\scripts\profiles；添加模型不会加载权重。" />
                                <ListBox x:Name="ManagedModelsList" MinHeight="82" MaxHeight="170"
                                         DisplayMemberPath="Summary"
                                         PreviewMouseWheel="NestedList_PreviewMouseWheel"
                                         SelectionChanged="ManagedModelsList_SelectionChanged" />
                                <TextBlock x:Name="SelectedModelDetailsText" Margin="0,10,0,0"
                                           Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"
                                           Text="请选择模型以查看文件、来源和参数摘要。" />
                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource SecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Local 保留 Desktop 的官方账户外壳以共享项目和历史，但官方凭据不会转发给 llama.cpp；它不是独立的本地账户登录。权限模式仍在 ChatGPT Desktop 输入框下方设置。" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="EditModelButton" Padding="18,9"
                                            Content="编辑选中模型" IsEnabled="False"
                                            Click="EditModelButton_Click" />
                                    <Button x:Name="AutoFitModelButton" Padding="18,9"
                                            Content="由 llama 自动适配" IsEnabled="False"
                                            Click="AutoFitModelButton_Click" />
                                    <Button x:Name="ModelDetailsButton" Padding="18,9"
                                            Content="模型详情" IsEnabled="False"
                                            Click="ModelDetailsButton_Click" />
                                    <Button x:Name="ActivateLocalButton" Padding="18,9"
                                            Content="切换并启动" IsEnabled="False"
                                            Click="ActivateLocalButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="RuntimeMonitorTab" Header="运行与缓存">
                <ScrollViewer x:Name="RuntimeMonitorScrollViewer" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="22" CornerRadius="14" Background="{StaticResource CardBackgroundBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" Text="电脑与 llama 实时状态" />
                                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="数据来自 Windows 与 llama.cpp 原生监控端点；驱动未公开的项目会明确标为不可用。" />
                                    </StackPanel>
                                    <Button x:Name="RefreshMonitoringButton" Grid.Column="1" Margin="12,0,0,0"
                                            Padding="18,9" Content="立即刷新" Click="RefreshMonitoringButton_Click" />
                                </Grid>
                                <TextBlock x:Name="HardwareInventoryText" Margin="0,16,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource PrimaryBrush}" Text="正在读取硬件清单…" />
                                <Separator Margin="0,16,0,12" />
                                <TextBlock x:Name="SystemPerformanceText" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}" Text="等待性能采样…" />
                                <TextBlock x:Name="LlamaRuntimeText" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}" Text="当前没有可监控的 Local Router。" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="LoadCurrentModelButton" Padding="18,9"
                                            Content="立即加载当前模型" IsEnabled="False"
                                            Click="LoadCurrentModelButton_Click" />
                                    <Button x:Name="UnloadCurrentModelButton" Padding="18,9"
                                            Content="立即释放当前模型" IsEnabled="False"
                                            Click="UnloadCurrentModelButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="22" CornerRadius="14"
                                Background="{StaticResource CardBackgroundBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" Text="llama 模型缓存" />
                                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="只显示 llama.cpp 标记为可删除、且由本启动器记录下载来源的缓存模型。Local 服务运行时禁止删除。" />
                                    </StackPanel>
                                    <Button x:Name="RefreshCacheButton" Grid.Column="1" Margin="12,0,0,0"
                                            Padding="18,9" Content="刷新缓存" Click="RefreshCacheButton_Click" />
                                </Grid>
                                <ListBox x:Name="CachedModelsList" Margin="0,14,0,12" MinHeight="90" MaxHeight="190"
                                         DisplayMemberPath="Summary" SelectionChanged="CachedModelsList_SelectionChanged"
                                         PreviewMouseWheel="RuntimeNestedList_PreviewMouseWheel" />
                                <Button x:Name="DeleteCachedModelButton" HorizontalAlignment="Left" Padding="18,9"
                                        Content="删除选中缓存" IsEnabled="False" Click="DeleteCachedModelButton_Click" />
                                <TextBlock x:Name="CacheStatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           Text="点击“刷新缓存”后由 llama.cpp 列出缓存。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="关于">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="28" CornerRadius="14" Background="{StaticResource CardBackgroundBrush}">
                            <StackPanel>
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="ChatGPT Local Launcher" />
                                <TextBlock Margin="0,8,0,0" FontSize="15"
                                           Foreground="{StaticResource SecondaryBrush}">
                                    <Run Text="版本 " />
                                    <Run x:Name="AboutVersionText" Text="0.9.0" />
                                    <Run Text=" · 公测版" />
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" FontSize="15"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           Text="开发者：甲总不是贾总" />

                                <Separator Margin="0,22,0,18" />
                                <TextBlock FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="产品说明" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           Text="用于在 ChatGPT Desktop 中切换 OpenAI 与本地 llama.cpp 模型，并管理本地模型、运行参数、服务状态和缓存。Launcher 保持为 llama.cpp 的薄管理外壳，不实现模型推理。" />

                                <TextBlock Margin="0,20,0,0" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="兼容范围" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           Text="支持 Windows 10 22H2 x64 与 Windows 11 x64。当前 CUDA 环境已经真机验证；Vulkan / AMD 环境依赖对应的 llama.cpp Runtime 与显卡驱动，仍需更多设备验证。" />

                                <Border Margin="0,22,0,0" Padding="14" CornerRadius="8" Background="#FFF7E6">
                                    <TextBlock Foreground="#7A4B00" TextWrapping="Wrap"
                                               Text="实验性功能：GGUF 在线搜索与下载依赖 llama.cpp 原生下载能力和当前网络环境，失败不会影响模型扫描、参数管理、模式切换与本地推理。" />
                                </Border>

                                <TextBlock Margin="0,20,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           Text="作者签名：自签名 Authenticode · CN=甲总不是贾总。证书 SHA-256 指纹：04FD703BF16895B37931EA173B68CA25DD73B3A06D110869717056CE786B2262。请以 Windows 文件属性中的“数字签名”页和官方发布说明为准。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryBrush}"
                   Text="准备就绪。真实 ChatGPT Desktop 配置保持不变。" />
    </Grid>
</Window>
